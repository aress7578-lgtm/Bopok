    "data:trees": "node scripts/build-trees.mjs"
  },
  "dependencies": {
    "@turf/turf": "^7.4.0",
    "maplibre-gl": "^6.16.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-map-gl": "^8.1.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/geojson-vt": "^3.2.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "geojson-vt": "^5.0.4",
    "mapshaper": "^0.7.101",
    "osmtogeojson": "3.0.0-beta.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "vt-pbf": "^3.1.3"
